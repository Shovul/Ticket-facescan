# ==============================================================================
# EVENTPASS ENVIRONMENT TEMPLATE (.env.example)
# Sao chép file này thành .env và điền các giá trị thực tế của bạn
# ==============================================================================
DB_HOST=localhost
DB_PORT=5433
DB_NAME=eventpass_db
DB_USER=postgres
DB_PASSWORD=your_password

ConnectionStrings__DefaultConnection="Host=localhost;Port=5433;Database=eventpass_db;Username=postgres;Password=your_password;"

JWT_SECRET=super_secret_key_eventpass_auth_2026_very_long_string_min_32_chars
JWT_ISSUER=EventPassAPI
JWT_AUDIENCE=EventPassClient

AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_API_KEY=eventpass_internal_ai_token_2026

# PayOS Online Payment Gateway
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here
PAYOS_RETURN_URL=http://localhost:3000/my-tickets
PAYOS_CANCEL_URL=http://localhost:3000/checkout

# Dropbox Cloud Storage (Lưu trữ ảnh khuôn mặt)
DROPBOX_APP_KEY=your_dropbox_app_key_here
DROPBOX_APP_SECRET=your_dropbox_app_secret_here
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token_here
DROPBOX_FOLDER_PATH=/EventPass

# Booking Payment & Mail Notification
BOOKING_BANK_CODE=MBBank
BOOKING_ACCOUNT_NUMBER=your_bank_account_number
BOOKING_ACCOUNT_NAME=EVENTPASS PAYMENT
BOOKING_MAIL_HOST=smtp.gmail.com
BOOKING_MAIL_PORT=587
BOOKING_MAIL_ENABLE_SSL=true
BOOKING_MAIL_FROM=your_email@gmail.com
BOOKING_MAIL_USERNAME=your_email@gmail.com
BOOKING_MAIL_PASSWORD=your_app_password

# User Notification / OTP Email Settings
EMAIL_SERVER=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SIGNALR_URL=http://localhost:5000/hubs
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
